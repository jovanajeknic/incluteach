{
  "name": "incluteach-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:check": "tsx src/scripts/checkDb.ts",
    "db:backup": "tsx src/scripts/backupDb.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "seed:schools": "tsx src/scripts/seedSchools.ts",
    "migrate": "node-pg-migrate -m migrations --envPath .env",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:test": "node-pg-migrate -m migrations --envPath .env --schema incluteach_test --create-schema up",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "fflate": "^0.8.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
