# Copy this file to .env and fill in your own values. Never commit .env.
# Only DATABASE_URL has no default; every other line can stay as it is for local development.

# --- Database ---------------------------------------------------------------------------------

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://incluteach_app:change_me@localhost:5432/incluteach

# Where "npm test" works: a separate set of tables in the same database, so the tests do not see
# the demo data (npm run seed:demo, npm run seed:schools). Use exactly this name and run
# "npm run migrate:test" once. Without this line the tests use the development tables and fail
# when they hold demo data (see README.md).
TEST_DB_SCHEMA=incluteach_test

# Full path of pg_dump, used by "npm run db:backup". Optional: the program is also looked for
# on the PATH and in the PostgreSQL folders in Program Files. It must be the same version as
# the database server or newer. Change the version number in the folder to yours.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# --- Server -----------------------------------------------------------------------------------

# Port the server listens on (optional, defaults to 3000).
PORT=3000

# Address of the website. Activation links that admins send out start with it.
# Optional, defaults to the local frontend (http://localhost:5173).
PUBLIC_URL=http://localhost:5173

# Set to "production" only on a real server. Then cookies are sent over HTTPS only, and the
# demo seed scripts (seed:demo, seed:schools) refuse to run. Leave it out on your computer.
# NODE_ENV=production

# Number of proxies between the browser and the server. Leave it out on your computer. On the
# free hosting (Netlify in front of Render) it is 2. Without it, all visitors look like one
# address to the limit on failed sign-ins.
# TRUST_PROXY=2

# --- AI (summaries and quizzes of lessons) ----------------------------------------------------

# Which AI service makes summaries and quizzes. "fake" makes invented but complete results and
# sends nothing anywhere. "groq" uses the Groq API and needs GROQ_API_KEY below; the text of a
# lesson (and nothing about students) is sent to it. Optional, defaults to "fake".
AI_PROVIDER=fake

# Your key for the Groq API (console.groq.com). Only on this computer, never in Git, never in a
# document. Used only when AI_PROVIDER=groq.
GROQ_API_KEY=

# The model, optional. Defaults to openai/gpt-oss-120b.
# AI_MODEL=openai/gpt-oss-120b

# --- Demo data (development only) -------------------------------------------------------------

# The password of every account made by "npm run seed:schools". Optional, defaults to
# "password".
# SEED_PASSWORD=password

# The password of every account made by "npm run seed:demo". Optional: when it is not set, a
# random one is chosen and shown once.
# DEMO_PASSWORD=
