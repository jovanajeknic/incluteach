# Copy this file to .env and fill in your own values. Never commit .env.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://incluteach_app:change_me@localhost:5432/incluteach

# Port the server listens on (optional, defaults to 3000).
PORT=3000

# Address of the website. Activation links that admins send out start with it.
# Optional, defaults to the local frontend (http://localhost:5173).
PUBLIC_URL=http://localhost:5173

# Full path of pg_dump, used by "npm run db:backup". Optional: the program is also looked for
# on the PATH and in the PostgreSQL folders in Program Files. It must be the same version as
# the database server or newer.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL8in\pg_dump.exe

# Which AI service makes summaries and quizzes. "fake" makes invented but complete results and
# sends nothing anywhere. "groq" uses the Groq API and needs GROQ_API_KEY below; the text of a
# lesson (and nothing about students) is sent to it. Optional, defaults to "fake".
# AI_PROVIDER=fake

# Your key for the Groq API (console.groq.com). Only on this computer, never in Git, never in a
# document. Used only when AI_PROVIDER=groq.
# GROQ_API_KEY=

# The model, optional. Defaults to openai/gpt-oss-120b.
# AI_MODEL=openai/gpt-oss-120b
